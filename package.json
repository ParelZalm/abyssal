{
  "name": "abyssal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "design": "vite --open /design.html",
    "sprite": "node scripts/import-sprite.mjs",
    "release": "npm run build && npm version",
    "version": "node scripts/changelog.mjs && git add CHANGELOG.md",
    "postversion": "git push --follow-tags",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
